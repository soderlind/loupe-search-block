#. Plugin Name of the plugin
#: loupe-search-block.php
msgid "Loupe Search Block"
msgstr "Loupe Search Block"

#. Plugin URI of the plugin
#: loupe-search-block.php
msgid "https://github.com/soderlind/loupe-search-block"
msgstr "https://github.com/soderlind/loupe-search-block"

#. Description of the plugin
#: loupe-search-block.php
msgid "A search block for Loupe Search: live search-as-you-type, post-type filter, taxonomy, author and custom-field facets, a date filter, and sorting."
msgstr "En søkeblokk for Loupe Search: direktesøk mens du skriver, filter for innholdstype, fasetter for taksonomier, forfattere og egendefinerte felt, datofilter og sortering."

#. Author of the plugin
#: loupe-search-block.php
msgid "Per Soderlind"
msgstr "Per Soderlind"

#. Author URI of the plugin
#: loupe-search-block.php
msgid "https://soderlind.no"
msgstr "https://soderlind.no"

#: build/search/render.php:24
#: build/search/index.js:2
msgid "The Loupe Search block needs the Loupe Search plugin to be active."
msgstr "Loupe Search-blokken krever at utvidelsen Loupe Search er aktiv."

#: build/search/render.php:44
#: build/search/index.js:2
msgid "Relevance"
msgstr "Relevans"

#: build/search/render.php:45
#: build/search/index.js:2
msgid "Newest first"
msgstr "Nyeste først"

#: build/search/render.php:46
#: build/search/index.js:2
msgid "Oldest first"
msgstr "Eldste først"

#: build/search/render.php:47
#: build/search/index.js:2
msgid "Title A–Z"
msgstr "Tittel A–Z"

#: build/search/render.php:48
#: build/search/index.js:2
msgid "Title Z–A"
msgstr "Tittel Z–A"

