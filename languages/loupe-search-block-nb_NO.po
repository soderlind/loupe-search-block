#. translators: %s: field name, e.g. "Post Author".
#: build/search/index.js:2
#, js-format
msgid "Needs %s marked Filterable in Settings → Loupe Search → Fields."
msgstr "Krever at %s er merket som filtrerbart under Innstillinger → Loupe Search → Felt."

#: build/search/index.js:2
msgid "Title sorting appears only for post types whose Title is Sortable."
msgstr "Tittelsortering vises bare for innholdstyper der Tittel er merket som sorterbart."

#: build/search/index.js:2
msgid "Title sorting needs Title marked Sortable in Settings → Loupe Search → Fields."
msgstr "Tittelsortering krever at Tittel er merket som sorterbart under Innstillinger → Loupe Search → Felt."

#: build/search/index.js:2
msgid "Search block preview"
msgstr "Forhåndsvisning av søkeblokken"

#: build/search/index.js:2
msgid "Content type"
msgstr "Innholdstype"

#: build/search/index.js:2
msgid "Sort order"
msgstr "Sorteringsrekkefølge"

#: build/search/index.js:2
msgid "Published from"
msgstr "Publisert fra"

#: build/search/index.js:2
msgid "Published to"
msgstr "Publisert til"

#: build/search/index.js:2
msgid "Options appear after searching."
msgstr "Valgene vises etter et søk."

#: build/search/index.js:2
msgid "Preview only. Search and filter values are not interactive in the editor."
msgstr "Kun forhåndsvisning. Søk og filterverdier er ikke interaktive i redigeringsverktøyet."

