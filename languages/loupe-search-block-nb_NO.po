msgid "No results found."
msgstr "Ingen treff."

#: build/search/render.php:81
msgid "Searching…"
msgstr "Søker…"

#: build/search/render.php:82
msgid "Search is not available right now. Please try again."
msgstr "Søket er ikke tilgjengelig akkurat nå. Prøv igjen."

#. translators: 1: current page number, 2: total number of pages.
#: build/search/render.php:84
#, php-format
msgid "Page %1$d of %2$d"
msgstr "Side %1$d av %2$d"

#: build/search/render.php:85
msgid "(no title)"
msgstr "(uten tittel)"

