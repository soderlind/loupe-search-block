msgid "Label"
msgstr "Etikett"

#: build/search/index.js:2
msgid "Placeholder"
msgstr "Plassholder"

#: build/search/index.js:2
msgid "Results per page"
msgstr "Treff per side"

#: build/search/index.js:2
msgid "Filters"
msgstr "Filtre"

#: build/search/index.js:2
msgid "Post type filter"
msgstr "Filter for innholdstype"

#: build/search/index.js:2
msgid "Hidden when only one content type is indexed."
msgstr "Skjult når bare én innholdstype er indeksert."

#: build/search/index.js:2
msgid "Taxonomy facets"
msgstr "Taksonomifasetter"

#: build/search/index.js:2
msgid "a taxonomy"
msgstr "en taksonomi"

#: build/search/index.js:2
msgid "Categories, tags and custom taxonomies."
msgstr "Kategorier, stikkord og egendefinerte taksonomier."

#: build/search/index.js:2
msgid "Author filter"
msgstr "Forfatterfilter"

#: build/search/index.js:2
msgid "Post Author"
msgstr "Innleggsforfatter"

#: build/search/index.js:2
msgid "Filter by post author."
msgstr "Filtrer etter innleggsforfatter."

#: build/search/index.js:2
msgid "Custom field facets"
msgstr "Fasetter for egendefinerte felt"

#: build/search/index.js:2
msgid "a custom field"
msgstr "et egendefinert felt"

#: build/search/index.js:2
msgid "Choose the fields below."
msgstr "Velg feltene nedenfor."

#: build/search/index.js:2
msgid "Custom fields"
msgstr "Egendefinerte felt"

#: build/search/index.js:2
msgid "Reset to all fields"
msgstr "Tilbakestill til alle felt"

#: build/search/index.js:2
msgid "Date filter"
msgstr "Datofilter"

#: build/search/index.js:2
msgid "Post Date"
msgstr "Publiseringsdato"

#: build/search/index.js:2
msgid "From and To dates for the publish date."
msgstr "Fra- og til-dato for publiseringsdatoen."

#: build/search/index.js:2
msgid "Sorting"
msgstr "Sortering"

#: build/search/index.js:2
msgid "Sort options"
msgstr "Sorteringsvalg"

#: build/search/index.js:2
msgid "Let visitors change the order of results."
msgstr "La besøkende endre rekkefølgen på treffene."

#: build/search/index.js:2
msgid "Default sort"
msgstr "Standard sortering"

#: build/search/index.js:2
msgid "Results"
msgstr "Treff"

#: build/search/index.js:2
msgid "Show excerpt"
msgstr "Vis utdrag"

#: build/search/index.js:2
msgid "Highlight matches"
msgstr "Uthev treff"

#: build/search/block.json
msgctxt "block title"
msgid "Loupe Search"
msgstr "Loupe Search"

#: build/search/block.json
msgctxt "block description"
msgid "Search this site with live results as you type, a post type filter, taxonomy, author and custom field facets, a date range, and sorting."
msgstr "Søk på nettstedet med treff mens du skriver, filter for innholdstype, fasetter for taksonomier, forfattere og egendefinerte felt, datointervall og sortering."

